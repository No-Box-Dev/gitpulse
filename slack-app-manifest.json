{
  "_metadata": {
    "major_version": 1
  },
  "display_information": {
    "name": "NoxConnect",
    "description": "Connects NoxCue, NoxFeed, NoxKey, NoxSpot, and NoxTicket to Slack.",
    "background_color": "#4A315F"
  },
  "features": {
    "bot_user": {
      "display_name": "NoxConnect",
      "always_online": false
    },
    "unfurl_domains": [
      "app.noxhere.com"
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://app.noxhere.com/api/slack/oauth/callback"
    ],
    "scopes": {
      "bot": [
        "channels:read",
        "groups:read",
        "chat:write",
        "chat:write.public",
        "links:read",
        "links:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://app.noxhere.com/api/slack/events",
      "bot_events": [
        "link_shared"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://app.noxhere.com/api/slack/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
